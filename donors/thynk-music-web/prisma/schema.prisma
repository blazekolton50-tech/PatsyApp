datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id        String   @id @default(cuid())
  name      String
  bpm       Int      @default(124)
  key       String   @default("A Minor")
  clips     Json
  mixer     Json
  effects   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stem {
  id        String  @id @default(cuid())
  projectId String
  type      String
  url       String
  isolated  Boolean @default(true)
}